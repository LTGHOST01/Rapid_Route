# Copy the backend block into backend/.env
# Copy the frontend block into frontend/.env
# Never commit real keys or JWT secrets.

# backend/.env — server-only; do not expose or commit real values
DATABASE_URL="postgresql://rapidroute:change-me@localhost:5432/rapidroute?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
GOOGLE_MAPS_API_KEY="server-routes-key"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# frontend/.env — this key is public by design but must be HTTP-referrer restricted
VITE_API_BASE_URL="http://localhost:4000/api"
VITE_GOOGLE_MAPS_BROWSER_KEY="browser-maps-js-key"
